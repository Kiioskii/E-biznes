<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://jakarta.ee/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://jakarta.ee/xml/ns/jakartaee
                             web-app_6_0.xsd"
         version="6.0">

  <context-param>
    <param-name>org.scalatra.cors.allowedOrigins</param-name>
    <param-value>http://localhost:3000,http://localhost:5173</param-value>
  </context-param>
  <context-param>
    <param-name>org.scalatra.cors.allowedMethods</param-name>
    <param-value>GET,POST,PUT,DELETE,OPTIONS,HEAD,PATCH</param-value>
  </context-param>

  <!--
    This listener loads a class in the default package called ScalatraBootstrap.
    That class should implement org.scalatra.LifeCycle.  Your app can be
    configured in Scala code there.
  -->
  <listener>
    <listener-class>org.scalatra.servlet.ScalatraListener</listener-class>
  </listener>
</web-app>
